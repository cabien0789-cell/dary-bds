<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= product.name %> - Dary BDS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- HEADER -->
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="header-brand">
      <svg width="36" height="36" viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
      <path d="M 195,115 L 195,565 L 290,565 C 465,565 565,462 565,340 C 565,218 465,115 290,115 Z M 258,182 L 290,182 C 422,182 495,252 495,340 C 495,428 422,498 290,498 L 258,498 Z" fill="#C9922A"/>
      <g transform="translate(350,335) rotate(-30)">
        <path d="M -230,-18 L 0,-18 L 0,-65 Q 0,-73 8,-73 L 62,-73 Q 70,-73 70,-65 L 70,65 Q 70,73 62,73 L 8,73 Q 0,73 0,65 L 0,18 L -230,18 Q -238,18 -238,10 L -238,-10 Q -238,-18 -230,-18 Z" fill="#C9922A"/>
      </g>
    </svg>
    <span class="header-brand-name">Dary BDS</span>
    </a>
    <div class="header-contact">
      <% if (settings.phone) { %>
      <a href="tel:<%= settings.phone %>" class="header-contact-item">
        <span class="header-contact-icon">📞</span>
        <span><%= settings.phone %></span>
      </a>
      <% } %>
      <% if (settings.zalo) { %>
      <a href="https://zalo.me/<%= settings.zalo %>" target="_blank" class="header-contact-item">
        <span class="header-contact-icon">💬</span>
        <span>Zalo</span>
      </a>
      <% } %>
      <% if (settings.facebook) { %>
      <a href="<%= settings.facebook %>" target="_blank" class="header-contact-item">
        <span class="header-contact-icon">📘</span>
        <span>Facebook</span>
      </a>
      <% } %>
    </div>
  </div>
</header>

<!-- NỘI DUNG -->
<div class="detail-wrap">

  <a href="/" class="detail-back">← Quay lại</a>

  <!-- THÔNG TIN SẢN PHẨM -->
  <div class="detail-info">
    <% const categoryLabel = { canho: 'Căn hộ', nhao: 'Nhà ở', dat: 'Đất' }; %>
    <span class="detail-category"><%= categoryLabel[product.category] || product.category %></span>
    <h1 class="detail-name"><%= product.name %></h1>
    <% if (product.price) { %><div class="detail-price"><%= product.price %></div><% } %>
    <div class="detail-meta">
      <% if (product.location) { %>
      <div class="detail-meta-item">
        <span class="detail-meta-label">📍 Vị trí:</span>
        <span><%= product.location %></span>
      </div>
      <% } %>
      <% if (product.contact) { %>
      <div class="detail-meta-item">
        <span class="detail-meta-label">📞 Liên hệ:</span>
        <span><%= product.contact %></span>
      </div>
      <% } %>
    </div>
  </div>

  <!-- MEDIA: VIDEO + ẢNH -->
  <div class="detail-media">
    <% if (product.video) { %>
    <video class="detail-video" controls>
      <source src="<%= product.video %>" type="video/mp4">
    </video>
    <% } %>
    <% const productImgs = (product.images || []).filter(img => img && img.url && !img.url.includes('dary-bds/desc')); %>
    <% if (productImgs.length > 0) { %>
    <div class="detail-images">
      <% productImgs.forEach((img, i) => { %>
        <% const url = typeof img === 'string' ? img : img.url; %>
        <img class="detail-img" src="<%= url %>" alt="Ảnh <%= i+1 %>" loading="lazy" onclick="openLightbox('<%= url %>')">
      <% }) %>
    </div>
    <% } %>
  </div>

  <!-- MÔ TẢ CHI TIẾT -->
  <% if (product.description) { %>
  <div class="detail-description">
    <div class="detail-description-title">📄 Mô tả chi tiết</div>
    <div class="detail-description-content"><%- product.description %></div>
  </div>
  <% } %>

</div>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox" onclick="closeLightbox()">
  <span class="lightbox-close" onclick="closeLightbox()">✕</span>
  <img id="lightboxImg" src="" alt="">
</div>

<!-- FOOTER -->
<footer class="site-footer">
  <p>© 2026 Dary BDS — Bất động sản uy tín</p>
</footer>

<script>
function openLightbox(url) {
  document.getElementById('lightboxImg').src = url;
  document.getElementById('lightbox').classList.add('active');
}
function closeLightbox() {
  document.getElementById('lightbox').classList.remove('active');
}
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeLightbox();
});
</script>

</body>
</html>
