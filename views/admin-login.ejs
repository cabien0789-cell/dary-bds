<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Đăng nhập Admin - Dary BDS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="admin-login-body">

  <div class="admin-login-box">

    <div class="admin-login-title" style="display:flex;align-items:center;justify-content:center;gap:10px;">
      <svg width="32" height="32" viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
        <path d="M 195,115 L 195,565 L 290,565 C 465,565 565,462 565,340 C 565,218 465,115 290,115 Z M 258,182 L 290,182 C 422,182 495,252 495,340 C 495,428 422,498 290,498 L 258,498 Z" fill="#C9922A"/>
        <g transform="translate(350,335) rotate(-30)">
          <path d="M -230,-18 L 0,-18 L 0,-65 Q 0,-73 8,-73 L 62,-73 Q 70,-73 70,-65 L 70,65 Q 70,73 62,73 L 8,73 Q 0,73 0,65 L 0,18 L -230,18 Q -238,18 -238,10 L -238,-10 Q -238,-18 -230,-18 Z" fill="#C9922A"/>
        </g>
      </svg>
      Dary BDS
    </div>
    <div class="admin-login-sub">Đăng nhập trang quản trị</div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="error-box"><%= error %></div>
    <% } %>

    <form method="POST" action="/admin/login">
      <div class="field-group">
        <label>Tên đăng nhập</label>
        <input type="text" name="username" placeholder="Nhập tên đăng nhập..." autocomplete="username" required>
      </div>
      <div class="field-group">
        <label>Mật khẩu</label>
        <input type="password" name="password" placeholder="Nhập mật khẩu..." autocomplete="current-password" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;margin-top:8px;">Đăng nhập</button>
    </form>

  </div>

</body>
</html>
