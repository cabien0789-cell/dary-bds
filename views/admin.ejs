// ═══════════════════════════════════════════════════
// ── RICH TEXT EDITOR — THÊM SẢN PHẨM (CREATE) ──
// ═══════════════════════════════════════════════════
const createEditor = document.getElementById('createEditor');
const createImgToolbar = document.getElementById('createImgToolbar');
let createSavedRange = null;
let createSelectedImg = null;
let createImageBytesMap = {};
let createPageReady = false;

createEditor.addEventListener('mouseup', () => saveRangeCreate());
createEditor.addEventListener('keyup', () => saveRangeCreate());
createEditor.addEventListener('focus', () => saveRangeCreate());

function saveRangeCreate() {
  const sel = window.getSelection();
  if (sel && sel.rangeCount > 0) createSavedRange = sel.getRangeAt(0).cloneRange();
}

function resetEditorCleanCreate() { createEditor.innerHTML = ''; }

function setFontSizeCreate(px) {
  createEditor.focus();
  const sel = window.getSelection();
  const hasSelection = sel && sel.rangeCount > 0 && !sel.getRangeAt(0).collapsed;
  if (hasSelection) {
    document.execCommand('fontSize', false, '7');
    createEditor.querySelectorAll('font[size="7"]').forEach(el => {
      el.removeAttribute('size');
      el.style.fontSize = px + 'px';
    });
  } else {
    const range = sel && sel.rangeCount > 0 ? sel.getRangeAt(0) : null;
    const span = document.createElement('span');
    span.style.fontSize = px + 'px';
    span.appendChild(document.createTextNode('\u200b'));
    if (range) {
      range.collapse(true);
      range.insertNode(span);
      const newRange = document.createRange();
      newRange.setStart(span.firstChild, 1);
      newRange.collapse(true);
      sel.removeAllRanges();
      sel.addRange(newRange);
    } else {
      createEditor.appendChild(span);
      const newRange = document.createRange();
      newRange.setStart(span.firstChild, 1);
      newRange.collapse(true);
      sel.removeAllRanges();
      sel.addRange(newRange);
    }
  }
}

createEditor.addEventListener('keydown', e => {
  if ((e.key === 'Delete' || e.key === 'Backspace') && createSelectedImg) {
    e.preventDefault();
    deleteSelectedImgCreate();
    return;
  }
  if (e.key === 'Tab') {
    e.preventDefault();
    document.execCommand('insertHTML', false, '\u00a0\u00a0\u00a0\u00a0');
    return;
  }
  if (e.key === 'Delete' || e.key === 'Backspace') {
    setTimeout(() => {
      const text = createEditor.innerText.replace(/\u200b/g, '').trim();
      if (text === '') resetEditorCleanCreate();
    }, 0);
  }
});

createEditor.addEventListener('input', e => {
  const text = createEditor.innerText.replace(/\u200b/g, '').trim();
  if (text === '') {
    setTimeout(() => {
      if (createEditor.innerText.replace(/\u200b/g, '').trim() === '') resetEditorCleanCreate();
    }, 0);
  }
});

createEditor.addEventListener('paste', e => {
  e.preventDefault();
  const clipboardData = e.clipboardData || window.clipboardData;
  let html = clipboardData.getData('text/html');
  if (html) {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    tmp.querySelectorAll('script,style,meta,link,head').forEach(el => el.remove());
    tmp.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(el => {
      const div = document.createElement('div');
      div.innerHTML = el.innerHTML;
      const sizeMap = { H1:'26px',H2:'22px',H3:'20px',H4:'18px',H5:'16px',H6:'14px' };
      div.style.fontWeight = 'bold';
      div.style.fontSize = sizeMap[el.tagName] || '16px';
      el.replaceWith(div);
    });
    tmp.querySelectorAll('ol').forEach(ol => {
      const frag = document.createDocumentFragment();
      let idx = 1;
      ol.querySelectorAll('li').forEach(li => {
        const div = document.createElement('div');
        div.innerHTML = idx + '. ' + li.innerHTML;
        frag.appendChild(div); idx++;
      });
      ol.replaceWith(frag);
    });
    tmp.querySelectorAll('ul').forEach(ul => {
      const frag = document.createDocumentFragment();
      ul.querySelectorAll('li').forEach(li => {
        const div = document.createElement('div');
        div.innerHTML = '• ' + li.innerHTML;
        frag.appendChild(div);
      });
      ul.replaceWith(frag);
    });
    tmp.querySelectorAll('li').forEach(li => {
      const div = document.createElement('div');
      div.innerHTML = li.innerHTML;
      li.replaceWith(div);
    });
    tmp.querySelectorAll('hr').forEach(hr => {
      const div = document.createElement('div');
      div.textContent = '──────────────────────────────────────────────────';
      div.style.color = '#ccc';
      hr.replaceWith(div);
    });
    tmp.querySelectorAll('*').forEach(el => {
      const allowed = ['style','src','href','alt','width','height','align'];
      Array.from(el.attributes).forEach(attr => {
        if (!allowed.includes(attr.name) && !attr.name.startsWith('data-')) el.removeAttribute(attr.name);
      });
      if (el.style && el.style.fontSize) el.style.fontSize = '';
    });
    const cleanHtml = tmp.innerHTML;
    const sel = window.getSelection();
    let isAllSelected = false;
    if (sel && sel.rangeCount > 0) {
      const range = sel.getRangeAt(0);
      const editorRange = document.createRange();
      editorRange.selectNodeContents(createEditor);
      isAllSelected = (range.startContainer===editorRange.startContainer && range.startOffset===editorRange.startOffset && range.endContainer===editorRange.endContainer && range.endOffset===editorRange.endOffset);
    }
    if (isAllSelected) {
      resetEditorCleanCreate();
      createEditor.focus();
      const selAfter = window.getSelection();
      const newRange = document.createRange();
      newRange.selectNodeContents(createEditor);
      newRange.collapse(true);
      selAfter.removeAllRanges();
      selAfter.addRange(newRange);
    } else {
      document.execCommand('removeFormat', false, null);
    }
    document.execCommand('insertHTML', false, cleanHtml);
    createEditor.querySelectorAll('img').forEach(img => {
      if (!img.dataset.bound) { img.dataset.bound='1'; bindImageEventsCreate(img); }
    });
  } else {
    document.execCommand('insertText', false, clipboardData.getData('text/plain'));
  }
});

let createSnapshotBeforeInput = null;
createEditor.addEventListener('beforeinput', e => {
  if (['deleteContentBackward','deleteContentForward','deleteByCut'].includes(e.inputType)) {
    createSnapshotBeforeInput = createEditor.innerHTML;
  } else { createSnapshotBeforeInput = null; }
});
createEditor.addEventListener('input', e => {
  if (!createSnapshotBeforeInput) return;
  if (!['deleteContentBackward','deleteContentForward','deleteByCut'].includes(e.inputType)) return;
  const currentText = createEditor.innerText.replace(/\u200b/g,'').trim();
  if (currentText === '') return;
  const tmpBefore = document.createElement('div');
  tmpBefore.innerHTML = createSnapshotBeforeInput;
  function getMap(root) {
    const map = [];
    function walk(node) {
      if (node.nodeType===3) {
        const text = node.textContent;
        if (!text) return;
        let parent = node.parentNode, bold=false, italic=false, underline=false;
        while (parent && parent!==root) {
          const tag = parent.tagName;
          if (tag==='B'||tag==='STRONG'||(parent.style&&parent.style.fontWeight==='bold')) bold=true;
          if (tag==='I'||tag==='EM'||(parent.style&&parent.style.fontStyle==='italic')) italic=true;
          if (tag==='U'||(parent.style&&parent.style.textDecoration&&parent.style.textDecoration.includes('underline'))) underline=true;
          parent=parent.parentNode;
        }
        map.push({text:text.trim(),bold,italic,underline,node});
      } else if (node.nodeType===1) { node.childNodes.forEach(walk); }
    }
    root.childNodes.forEach(walk);
    return map;
  }
  const beforeMap = getMap(tmpBefore);
  const currentMap = getMap(createEditor);
  beforeMap.forEach(bItem => {
    if (!bItem.text) return;
    const match = currentMap.find(cItem => cItem.text===bItem.text && !cItem.bold && !cItem.italic && !cItem.underline);
    if (match && (bItem.bold||bItem.italic||bItem.underline)) {
      const textNode = match.node;
      const parent = textNode.parentNode;
      if (!parent) return;
      const span = document.createElement('span');
      if (bItem.bold) span.style.fontWeight='bold';
      if (bItem.italic) span.style.fontStyle='italic';
      if (bItem.underline) span.style.textDecoration='underline';
      parent.insertBefore(span, textNode);
      span.appendChild(textNode);
    }
  });
  createSnapshotBeforeInput = null;
}, true);

function bindImageEventsCreate(img) {
  img.addEventListener('click', e => { e.stopPropagation(); selectImgCreate(img); });
}
function selectImgCreate(img) {
  if (!createPageReady) return;
  if (createSelectedImg && createSelectedImg !== img) deselectImgCreate();
  createSelectedImg = img;
  img.classList.add('img-selected');
  const rect = img.getBoundingClientRect();
  createImgToolbar.style.display = 'flex';
  createImgToolbar.style.top = (window.scrollY + rect.bottom + 6) + 'px';
  createImgToolbar.style.left = rect.left + 'px';
  if (!img.nextSibling || !img.nextSibling.classList || !img.nextSibling.classList.contains('img-resize-handle')) {
    const handle = document.createElement('div');
    handle.className = 'img-resize-handle';
    handle.addEventListener('mousedown', e => startResizeCreate(e, img));
    handle.addEventListener('touchstart', e => startResizeTouchCreate(e, img), { passive: false });
    img.parentNode.insertBefore(handle, img.nextSibling);
    handle.style.top = (img.offsetTop + img.offsetHeight - 16) + 'px';
    handle.style.left = (img.offsetLeft + img.offsetWidth - 16) + 'px';
  }
}
function deselectImgCreate() {
  if (!createSelectedImg) return;
  createSelectedImg.classList.remove('img-selected');
  const handle = createSelectedImg.nextSibling;
  if (handle && handle.classList && handle.classList.contains('img-resize-handle')) handle.remove();
  createSelectedImg = null;
  createImgToolbar.style.display = 'none';
}
function deleteSelectedImgCreate() {
  if (!createSelectedImg) return;
  const handle = createSelectedImg.nextSibling;
  if (handle && handle.classList && handle.classList.contains('img-resize-handle')) handle.remove();
  createSelectedImg.remove();
  createSelectedImg = null;
  createImgToolbar.style.display = 'none';
}
document.addEventListener('click', e => {
  if (e.target !== createSelectedImg && !e.target.closest('#createImgToolbar') && !e.target.closest('.img-resize-handle')) deselectImgCreate();
});
function startResizeCreate(e, img) {
  e.preventDefault();
  let resizeStartX = e.clientX, resizeStartW = img.offsetWidth;
  function onMouseMove(e) {
    const newW = Math.max(60, resizeStartW + e.clientX - resizeStartX);
    img.style.width = newW + 'px'; img.style.maxWidth = '100%';
    const handle = img.nextSibling;
    if (handle && handle.classList && handle.classList.contains('img-resize-handle')) {
      handle.style.left = (img.offsetLeft + img.offsetWidth - 16) + 'px';
      handle.style.top = (img.offsetTop + img.offsetHeight - 16) + 'px';
    }
    const rect = img.getBoundingClientRect();
    createImgToolbar.style.top = (window.scrollY + rect.bottom + 6) + 'px';
    createImgToolbar.style.left = rect.left + 'px';
  }
  function onMouseUp() { document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp); }
  document.addEventListener('mousemove', onMouseMove);
  document.addEventListener('mouseup', onMouseUp);
}
function startResizeTouchCreate(e, img) {
  e.preventDefault();
  const touch = e.touches[0];
  let resizeStartX = touch.clientX, resizeStartW = img.offsetWidth;
  function onTouchMove(e) {
    const t = e.touches[0];
    const newW = Math.max(60, resizeStartW + t.clientX - resizeStartX);
    img.style.width = newW + 'px'; img.style.maxWidth = '100%';
    const handle = img.nextSibling;
    if (handle && handle.classList && handle.classList.contains('img-resize-handle')) {
      handle.style.left = (img.offsetLeft + img.offsetWidth - 16) + 'px';
      handle.style.top = (img.offsetTop + img.offsetHeight - 16) + 'px';
    }
    const rect = img.getBoundingClientRect();
    createImgToolbar.style.top = (window.scrollY + rect.bottom + 6) + 'px';
    createImgToolbar.style.left = rect.left + 'px';
  }
  function onTouchEnd() { document.removeEventListener('touchmove', onTouchMove); document.removeEventListener('touchend', onTouchEnd); }
  document.addEventListener('touchmove', onTouchMove, { passive: false });
  document.addEventListener('touchend', onTouchEnd);
}

setTimeout(() => { createPageReady = true; }, 800);

async function uploadImageCreate(input) {
  const file = input.files[0];
  if (!file) return;
  if (!['image/png','image/jpeg','image/jpg'].includes(file.type)) {
    showErrorCreate('Chỉ chấp nhận file png hoặc jpg/jpeg.');
    input.value = ''; return;
  }
  showErrorCreate('Để thêm ảnh vào mô tả, hãy thêm sản phẩm trước rồi vào Sửa để chèn ảnh vào mô tả.');
  input.value = '';
}

function showErrorCreate(msg) {
  const el = document.getElementById('createError');
  el.textContent = msg; el.style.display = 'block';
}

// ═══════════════════════════════════════════════════
// ── RICH TEXT EDITOR — SỬA SẢN PHẨM (EDIT) ──
// ═══════════════════════════════════════════════════
const editEditor = document.getElementById('editEditor');
const editImgToolbar = document.getElementById('editImgToolbar');
let editSavedRange = null;
let editSelectedImg = null;
let editImageBytesMap = {};
let editPageReady = false;
let currentEditId = null;

editEditor.addEventListener('mouseup', () => saveRangeEdit());
editEditor.addEventListener('keyup', () => saveRangeEdit());
editEditor.addEventListener('focus', () => saveRangeEdit());

function saveRangeEdit() {
  const sel = window.getSelection();
  if (sel && sel.rangeCount > 0) editSavedRange = sel.getRangeAt(0).cloneRange();
}

function resetEditorCleanEdit() { editEditor.innerHTML = ''; }

function cleanEditorContentEdit() {
  editEditor.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(el => {
    const div = document.createElement('div');
    div.innerHTML = el.innerHTML; div.style.fontWeight = 'bold'; el.replaceWith(div);
  });
  editEditor.querySelectorAll('ol').forEach(ol => {
    const frag = document.createDocumentFragment(); let idx = 1;
    ol.querySelectorAll('li').forEach(li => {
      const div = document.createElement('div');
      div.innerHTML = idx + '. ' + li.innerHTML; frag.appendChild(div); idx++;
    });
    ol.replaceWith(frag);
  });
  editEditor.querySelectorAll('ul').forEach(ul => {
    const frag = document.createDocumentFragment();
    ul.querySelectorAll('li').forEach(li => {
      const div = document.createElement('div');
      div.innerHTML = '• ' + li.innerHTML; frag.appendChild(div);
    });
    ul.replaceWith(frag);
  });
  editEditor.querySelectorAll('li').forEach(li => {
    const div = document.createElement('div'); div.innerHTML = li.innerHTML; li.replaceWith(div);
  });
  editEditor.querySelectorAll('hr').forEach(hr => {
    const div = document.createElement('div');
    div.textContent = '──────────────────────────────────────────────────';
    div.style.color = '#ccc'; hr.replaceWith(div);
  });
  editEditor.querySelectorAll('div,p').forEach(el => {
    if (el.style && el.style.borderBottom) {
      el.style.borderBottom = ''; el.style.margin = '';
      el.textContent = '──────────────────────────────────────────────────';
      el.style.color = '#ccc';
    }
  });
}

function setFontSizeEdit(px) {
  editEditor.focus();
  const sel = window.getSelection();
  const hasSelection = sel && sel.rangeCount > 0 && !sel.getRangeAt(0).collapsed;
  if (hasSelection) {
    document.execCommand('fontSize', false, '7');
    editEditor.querySelectorAll('font[size="7"]').forEach(el => {
      el.removeAttribute('size'); el.style.fontSize = px + 'px';
    });
  } else {
    const range = sel && sel.rangeCount > 0 ? sel.getRangeAt(0) : null;
    const span = document.createElement('span');
    span.style.fontSize = px + 'px';
    span.appendChild(document.createTextNode('\u200b'));
    if (range) {
      range.collapse(true); range.insertNode(span);
      const newRange = document.createRange();
      newRange.setStart(span.firstChild, 1); newRange.collapse(true);
      sel.removeAllRanges(); sel.addRange(newRange);
    } else {
      editEditor.appendChild(span);
      const newRange = document.createRange();
      newRange.setStart(span.firstChild, 1); newRange.collapse(true);
      sel.removeAllRanges(); sel.addRange(newRange);
    }
  }
}

editEditor.addEventListener('keydown', e => {
  if ((e.key === 'Delete' || e.key === 'Backspace') && editSelectedImg) {
    e.preventDefault(); deleteSelectedImgEdit(); return;
  }
  if (e.key === 'Tab') {
    e.preventDefault();
    document.execCommand('insertHTML', false, '\u00a0\u00a0\u00a0\u00a0'); return;
  }
  if (e.key === 'Delete' || e.key === 'Backspace') {
    setTimeout(() => {
      if (editEditor.innerText.replace(/\u200b/g,'').trim() === '') resetEditorCleanEdit();
    }, 0);
  }
});

editEditor.addEventListener('input', e => {
  if (editEditor.innerText.replace(/\u200b/g,'').trim() === '') {
    setTimeout(() => {
      if (editEditor.innerText.replace(/\u200b/g,'').trim() === '') resetEditorCleanEdit();
    }, 0);
  }
});

editEditor.addEventListener('paste', e => {
  e.preventDefault();
  const clipboardData = e.clipboardData || window.clipboardData;
  let html = clipboardData.getData('text/html');
  if (html) {
    const tmp = document.createElement('div');
    tmp.innerHTML = html;
    tmp.querySelectorAll('script,style,meta,link,head').forEach(el => el.remove());
    tmp.querySelectorAll('h1,h2,h3,h4,h5,h6').forEach(el => {
      const div = document.createElement('div');
      div.innerHTML = el.innerHTML;
      const sizeMap = { H1:'26px',H2:'22px',H3:'20px',H4:'18px',H5:'16px',H6:'14px' };
      div.style.fontWeight = 'bold'; div.style.fontSize = sizeMap[el.tagName] || '16px';
      el.replaceWith(div);
    });
    tmp.querySelectorAll('ol').forEach(ol => {
      const frag = document.createDocumentFragment(); let idx = 1;
      ol.querySelectorAll('li').forEach(li => {
        const div = document.createElement('div');
        div.innerHTML = idx + '. ' + li.innerHTML; frag.appendChild(div); idx++;
      });
      ol.replaceWith(frag);
    });
    tmp.querySelectorAll('ul').forEach(ul => {
      const frag = document.createDocumentFragment();
      ul.querySelectorAll('li').forEach(li => {
        const div = document.createElement('div');
        div.innerHTML = '• ' + li.innerHTML; frag.appendChild(div);
      });
      ul.replaceWith(frag);
    });
    tmp.querySelectorAll('li').forEach(li => {
      const div = document.createElement('div'); div.innerHTML = li.innerHTML; li.replaceWith(div);
    });
    tmp.querySelectorAll('hr').forEach(hr => {
      const div = document.createElement('div');
      div.textContent = '──────────────────────────────────────────────────';
      div.style.color = '#ccc'; hr.replaceWith(div);
    });
    tmp.querySelectorAll('*').forEach(el => {
      const allowed = ['style','src','href','alt','width','height','align'];
      Array.from(el.attributes).forEach(attr => {
        if (!allowed.includes(attr.name) && !attr.name.startsWith('data-')) el.removeAttribute(attr.name);
      });
      if (el.style && el.style.fontSize) el.style.fontSize = '';
    });
    const cleanHtml = tmp.innerHTML;
    const sel = window.getSelection();
    let isAllSelected = false;
    if (sel && sel.rangeCount > 0) {
      const range = sel.getRangeAt(0);
      const editorRange = document.createRange();
      editorRange.selectNodeContents(editEditor);
      isAllSelected = (range.startContainer===editorRange.startContainer && range.startOffset===editorRange.startOffset && range.endContainer===editorRange.endContainer && range.endOffset===editorRange.endOffset);
    }
    if (isAllSelected) {
      resetEditorCleanEdit();
      editEditor.focus();
      const selAfter = window.getSelection();
      const newRange = document.createRange();
      newRange.selectNodeContents(editEditor); newRange.collapse(true);
      selAfter.removeAllRanges(); selAfter.addRange(newRange);
    } else { document.execCommand('removeFormat', false, null); }
    document.execCommand('insertHTML', false, cleanHtml);
    editEditor.querySelectorAll('img').forEach(img => {
      if (!img.dataset.bound) { img.dataset.bound='1'; bindImageEventsEdit(img); }
    });
  } else {
    document.execCommand('insertText', false, clipboardData.getData('text/plain'));
  }
});

let editSnapshotBeforeInput = null;
editEditor.addEventListener('beforeinput', e => {
  if (['deleteContentBackward','deleteContentForward','deleteByCut'].includes(e.inputType)) {
    editSnapshotBeforeInput = editEditor.innerHTML;
  } else { editSnapshotBeforeInput = null; }
});
editEditor.addEventListener('input', e => {
  if (!editSnapshotBeforeInput) return;
  if (!['deleteContentBackward','deleteContentForward','deleteByCut'].includes(e.inputType)) return;
  const currentText = editEditor.innerText.replace(/\u200b/g,'').trim();
  if (currentText === '') return;
  const tmpBefore = document.createElement('div');
  tmpBefore.innerHTML = editSnapshotBeforeInput;
  function getMapEdit(root) {
    const map = [];
    function walk(node) {
      if (node.nodeType===3) {
        const text = node.textContent;
        if (!text) return;
        let parent = node.parentNode, bold=false, italic=false, underline=false;
        while (parent && parent!==root) {
          const tag = parent.tagName;
          if (tag==='B'||tag==='STRONG'||(parent.style&&parent.style.fontWeight==='bold')) bold=true;
          if (tag==='I'||tag==='EM'||(parent.style&&parent.style.fontStyle==='italic')) italic=true;
          if (tag==='U'||(parent.style&&parent.style.textDecoration&&parent.style.textDecoration.includes('underline'))) underline=true;
          parent=parent.parentNode;
        }
        map.push({text:text.trim(),bold,italic,underline,node});
      } else if (node.nodeType===1) { node.childNodes.forEach(walk); }
    }
    root.childNodes.forEach(walk);
    return map;
  }
  const beforeMap = getMapEdit(tmpBefore);
  const currentMap = getMapEdit(editEditor);
  beforeMap.forEach(bItem => {
    if (!bItem.text) return;
    const match = currentMap.find(cItem => cItem.text===bItem.text && !cItem.bold && !cItem.italic && !cItem.underline);
    if (match && (bItem.bold||bItem.italic||bItem.underline)) {
      const textNode = match.node;
      const parent = textNode.parentNode;
      if (!parent) return;
      const span = document.createElement('span');
      if (bItem.bold) span.style.fontWeight='bold';
      if (bItem.italic) span.style.fontStyle='italic';
      if (bItem.underline) span.style.textDecoration='underline';
      parent.insertBefore(span, textNode);
      span.appendChild(textNode);
    }
  });
  editSnapshotBeforeInput = null;
}, true);

function bindImageEventsEdit(img) {
  img.addEventListener('click', e => { e.stopPropagation(); selectImgEdit(img); });
}
function selectImgEdit(img) {
  if (!editPageReady) return;
  if (editSelectedImg && editSelectedImg !== img) deselectImgEdit();
  editSelectedImg = img;
  img.classList.add('img-selected');
  const rect = img.getBoundingClientRect();
  editImgToolbar.style.display = 'flex';
  editImgToolbar.style.top = (window.scrollY + rect.bottom + 6) + 'px';
  editImgToolbar.style.left = rect.left + 'px';
  if (!img.nextSibling || !img.nextSibling.classList || !img.nextSibling.classList.contains('img-resize-handle')) {
    const handle = document.createElement('div');
    handle.className = 'img-resize-handle';
    handle.addEventListener('mousedown', e => startResizeEdit(e, img));
    handle.addEventListener('touchstart', e => startResizeTouchEdit(e, img), { passive: false });
    img.parentNode.insertBefore(handle, img.nextSibling);
    handle.style.top = (img.offsetTop + img.offsetHeight - 16) + 'px';
    handle.style.left = (img.offsetLeft + img.offsetWidth - 16) + 'px';
  }
}
function deselectImgEdit() {
  if (!editSelectedImg) return;
  editSelectedImg.classList.remove('img-selected');
  const handle = editSelectedImg.nextSibling;
  if (handle && handle.classList && handle.classList.contains('img-resize-handle')) handle.remove();
  editSelectedImg = null;
  editImgToolbar.style.display = 'none';
}
function deleteSelectedImgEdit() {
  if (!editSelectedImg) return;
  const handle = editSelectedImg.nextSibling;
  if (handle && handle.classList && handle.classList.contains('img-resize-handle')) handle.remove();
  editSelectedImg.remove();
  editSelectedImg = null;
  editImgToolbar.style.display = 'none';
}
function startResizeEdit(e, img) {
  e.preventDefault();
  let resizeStartX = e.clientX, resizeStartW = img.offsetWidth;
  function onMouseMove(e) {
    const newW = Math.max(60, resizeStartW + e.clientX - resizeStartX);
    img.style.width = newW + 'px'; img.style.maxWidth = '100%';
    const handle = img.nextSibling;
    if (handle && handle.classList && handle.classList.contains('img-resize-handle')) {
      handle.style.left = (img.offsetLeft + img.offsetWidth - 16) + 'px';
      handle.style.top = (img.offsetTop + img.offsetHeight - 16) + 'px';
    }
    const rect = img.getBoundingClientRect();
    editImgToolbar.style.top = (window.scrollY + rect.bottom + 6) + 'px';
    editImgToolbar.style.left = rect.left + 'px';
  }
  function onMouseUp() { document.removeEventListener('mousemove', onMouseMove); document.removeEventListener('mouseup', onMouseUp); }
  document.addEventListener('mousemove', onMouseMove);
  document.addEventListener('mouseup', onMouseUp);
}
function startResizeTouchEdit(e, img) {
  e.preventDefault();
  const touch = e.touches[0];
  let resizeStartX = touch.clientX, resizeStartW = img.offsetWidth;
  function onTouchMove(e) {
    const t = e.touches[0];
    const newW = Math.max(60, resizeStartW + t.clientX - resizeStartX);
    img.style.width = newW + 'px'; img.style.maxWidth = '100%';
    const handle = img.nextSibling;
    if (handle && handle.classList && handle.classList.contains('img-resize-handle')) {
      handle.style.left = (img.offsetLeft + img.offsetWidth - 16) + 'px';
      handle.style.top = (img.offsetTop + img.offsetHeight - 16) + 'px';
    }
    const rect = img.getBoundingClientRect();
    editImgToolbar.style.top = (window.scrollY + rect.bottom + 6) + 'px';
    editImgToolbar.style.left = rect.left + 'px';
  }
  function onTouchEnd() { document.removeEventListener('touchmove', onTouchMove); document.removeEventListener('touchend', onTouchEnd); }
  document.addEventListener('touchmove', onTouchMove, { passive: false });
  document.addEventListener('touchend', onTouchEnd);
}

async function uploadImageEdit(input) {
  const file = input.files[0];
  if (!file) return;
  if (!['image/png','image/jpeg','image/jpg'].includes(file.type)) {
    showErrorEdit('Chỉ chấp nhận file png hoặc jpg/jpeg.');
    input.value = ''; return;
  }
  const formData = new FormData();
  formData.append('image', file);
  const res = await fetch('/admin/products/' + currentEditId + '/upload-image', { method: 'POST', body: formData });
  const data = await res.json();
  if (data.error) { showErrorEdit(data.error); input.value = ''; return; }
  if (data.bytes) editImageBytesMap[data.url] = data.bytes;
  const img = document.createElement('img');
  img.src = data.url;
  img.style.maxWidth = '100%';
  img.style.borderRadius = '8px';
  img.style.margin = '8px 0';
  img.style.display = 'block';
  bindImageEventsEdit(img);
  const rangeInsideEditor = editSavedRange && editEditor.contains(editSavedRange.commonAncestorContainer);
  const lineBreak = document.createElement('br');
  if (rangeInsideEditor) {
    editEditor.focus();
    const sel = window.getSelection();
    sel.removeAllRanges(); sel.addRange(editSavedRange);
    editSavedRange.deleteContents();
    editSavedRange.insertNode(lineBreak);
    editSavedRange.insertNode(img);
    const newRange = document.createRange();
    newRange.setStartAfter(lineBreak); newRange.collapse(true);
    sel.removeAllRanges(); sel.addRange(newRange);
    editSavedRange = newRange.cloneRange();
  } else {
    editEditor.appendChild(img);
    editEditor.appendChild(lineBreak);
    editEditor.focus();
    const sel = window.getSelection();
    const newRange = document.createRange();
    newRange.setStartAfter(lineBreak); newRange.collapse(true);
    sel.removeAllRanges(); sel.addRange(newRange);
    editSavedRange = newRange.cloneRange();
  }
  input.value = '';
}

function showErrorEdit(msg) {
  const el = document.getElementById('editError');
  el.textContent = msg; el.style.display = 'block';
}
</script>

