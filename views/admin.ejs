// ── MỞ/ĐÓNG MODAL SỬA ──
function openEditModal(id) {
  const p = allProducts.find(x => x._id === id || String(x._id) === String(id));
  if (!p) return;
  currentEditId = id;
  editPageReady = false;
  editImageBytesMap = {};

  document.getElementById('editForm').action = '/admin/products/' + id + '/edit';
  document.getElementById('editName').value = p.name || '';
  document.getElementById('editPrice').value = p.price || '';
  document.getElementById('editLocation').value = p.location || '';
  document.getElementById('editContact').value = p.contact || '';
  document.getElementById('editCategory').value = p.category || 'canho';
  document.getElementById('editDeleteVideo').value = 'no';
  document.getElementById('editError').style.display = 'none';

  // Ảnh hiện tại
  const preview = document.getElementById('editImagesPreview');
  preview.innerHTML = '';
  const currentAvatar = p.avatarIndex || 0;
  document.getElementById('editAvatarIndex').value = currentAvatar;
  (p.images || []).forEach((img, i) => {
    const url = typeof img === 'string' ? img : img.url;
    const bytes = typeof img === 'object' ? img.bytes : 0;
    editImageBytesMap[url] = bytes || 0;
    const isAvatar = i === currentAvatar;
    const item = document.createElement('div');
    item.className = 'image-preview-item';
    item.style.cursor = 'pointer';
    item.dataset.imgIndex = i;
    const imgEl = document.createElement('img');
    imgEl.src = url;
    imgEl.style.cssText = 'width:100%;height:100%;object-fit:cover;border-radius:8px;border:' + (isAvatar?'2.5px solid var(--primary)':'2px solid var(--border)') + ';display:block;';
    const avatarLabel = document.createElement('div');
    avatarLabel.style.cssText = 'position:absolute;bottom:0;left:0;right:0;background:rgba(0,0,0,0.6);color:#fff;font-size:11px;text-align:center;padding:2px 0;border-radius:0 0 6px 6px;pointer-events:none;';
    avatarLabel.textContent = isAvatar?'✓ Ảnh bìa':'';
    const delBtn = document.createElement('button');
    delBtn.className = 'image-preview-delete';
    delBtn.type = 'button';
    delBtn.title = 'Xóa ảnh này';
    delBtn.textContent = '✕';
    const hiddenInput = document.createElement('input');
    hiddenInput.type = 'hidden';
    hiddenInput.name = 'deleteImages';
    hiddenInput.value = url;
    hiddenInput.disabled = true;
    item.appendChild(imgEl);
    item.appendChild(avatarLabel);
    item.appendChild(delBtn);
    item.appendChild(hiddenInput);
    item.addEventListener('click', function(e) {
      if (e.target === delBtn) return;
      const idx = parseInt(this.dataset.imgIndex);
      document.getElementById('editAvatarIndex').value = idx;
      preview.querySelectorAll('.image-preview-item').forEach((it, ii) => {
        const im = it.querySelector('img');
        const lb = it.querySelector('div');
        if (im) im.style.border = ii===idx?'2.5px solid var(--primary)':'2px solid var(--border)';
        if (lb) lb.textContent = ii===idx?'✓ Ảnh bìa':'';
      });
    });
    delBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      markDeleteImage(this, url);
    });
    preview.appendChild(item);
  });

  // Video hiện tại
  const videoInfo = document.getElementById('editVideoInfo');
  if (p.video) {
    videoInfo.innerHTML = '<video src="' + p.video + '" style="max-width:200px;border-radius:8px;margin-bottom:8px;" controls></video><br><button type="button" class="btn btn-danger btn-sm" onclick="markDeleteVideo(this)">🗑 Xóa video này</button>';
  } else {
    videoInfo.innerHTML = '<span style="color:var(--text3);font-size:13px;">Chưa có video</span>';
  }

  // Nội dung mô tả
  editEditor.innerHTML = p.description || '';
  cleanEditorContentEdit();
  if (editEditor.innerHTML.replace(/<br\s*\/?>/gi,'').trim() === '') editEditor.innerHTML = '';
  editEditor.querySelectorAll('img').forEach(img => {
    img.classList.remove('img-selected');
    if (!img.dataset.bound) { img.dataset.bound='1'; bindImageEventsEdit(img); }
  });
  editEditor.querySelectorAll('.img-resize-handle').forEach(h => h.remove());
  editImgToolbar.style.display = 'none';
  editSelectedImg = null;

  document.getElementById('editModal').classList.add('active');
  setTimeout(() => { editPageReady = true; }, 800);
}

function closeEditModal() {
  document.getElementById('editModal').classList.remove('active');
  editEditor.innerHTML = '';
  currentEditId = null;
  editSelectedImg = null;
  editImgToolbar.style.display = 'none';
}

function markDeleteImage(btn, url) {
  const item = btn.closest('.image-preview-item');
  const hiddenInput = item.querySelector('input[type="hidden"]');
  if (item.style.opacity === '0.3') {
    item.style.opacity = '1';
    hiddenInput.disabled = true;
    btn.style.background = 'var(--red)';
  } else {
    item.style.opacity = '0.3';
    hiddenInput.disabled = false;
    btn.style.background = '#888';
  }
}

function markDeleteVideo(btn) {
  document.getElementById('editDeleteVideo').value = 'yes';
  btn.disabled = true;
  btn.textContent = '✓ Sẽ xóa video khi lưu';
  btn.style.opacity = '0.5';
}

function submitEdit() {
  document.getElementById('editDescription').value = editEditor.innerHTML;
  document.getElementById('editForm').submit();
}

// Đóng modal khi bấm ra ngoài
document.getElementById('editModal').addEventListener('click', e => {
  if (e.target === document.getElementById('editModal')) closeEditModal();
});
</script>

</body>
</html>
