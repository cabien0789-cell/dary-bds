<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản trị - Dary BDS</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* ── UPLOAD ẢNH MỚI ── */
    .upload-zone {
      border: 2px dashed var(--border2);
      border-radius: var(--radius-sm);
      padding: 28px 20px;
      text-align: center;
      cursor: pointer;
      transition: var(--transition);
      background: var(--bg);
      position: relative;
    }
    .upload-zone:hover { border-color: var(--primary); background: var(--primary-light); }
    .upload-zone input[type="file"] {
      position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;
    }
    .upload-zone-icon { font-size: 32px; margin-bottom: 8px; }
    .upload-zone-text { font-size: 14px; color: var(--text2); font-weight: 600; }
    .upload-zone-sub { font-size: 12px; color: var(--text3); margin-top: 4px; }

    /* ── PREVIEW LƯỚI ẢNH ── */
    .img-preview-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 12px;
      margin-top: 14px;
    }
    .img-preview-item {
      position: relative;
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 2.5px solid var(--border);
      cursor: pointer;
      transition: var(--transition);
      background: var(--bg);
      aspect-ratio: 4/3;
    }
    .img-preview-item img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .img-preview-item.is-avatar {
      border-color: var(--primary);
      box-shadow: 0 0 0 3px rgba(200,151,58,0.25);
    }
    .img-preview-badge {
      position: absolute; top: 6px; left: 6px;
      background: var(--primary); color: white;
      font-size: 10px; font-weight: 800;
      padding: 2px 8px; border-radius: 10px;
      letter-spacing: 0.3px;
      display: none;
    }
    .img-preview-item.is-avatar .img-preview-badge { display: block; }
    .img-preview-remove {
      position: absolute; top: 6px; right: 6px;
      width: 24px; height: 24px;
      background: rgba(192,57,43,0.88); color: white;
      border: none; border-radius: 50%;
      font-size: 14px; font-weight: 700;
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      line-height: 1; transition: var(--transition);
    }
    .img-preview-remove:hover { background: var(--red); }
    .img-preview-hint {
      position: absolute; bottom: 0; left: 0; right: 0;
      background: rgba(0,0,0,0.55); color: white;
      font-size: 10px; text-align: center; padding: 4px;
      opacity: 0; transition: opacity 0.2s;
    }
    .img-preview-item:hover .img-preview-hint { opacity: 1; }

    /* ── VIDEO PREVIEW ── */
    .video-preview-wrap {
      margin-top: 12px;
      background: var(--bg);
      border: 1.5px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .video-preview-wrap video {
      width: 160px; border-radius: 6px; flex-shrink: 0;
    }
    .video-preview-info { flex: 1; }
    .video-preview-name { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 4px; word-break: break-all; }
    .video-preview-size { font-size: 12px; color: var(--text3); }
    .video-preview-remove {
      background: var(--red-bg); border: 1.5px solid var(--red-border); color: var(--red);
      padding: 6px 14px; border-radius: 6px; font-size: 13px; font-weight: 600;
      cursor: pointer; transition: var(--transition); white-space: nowrap;
    }
    .video-preview-remove:hover { background: var(--red); color: white; border-color: var(--red); }

    /* Ảnh xóa trong form sửa */
    .img-preview-item.marked-delete { opacity: 0.3; }
    .img-preview-item.marked-delete .img-preview-badge { display: none !important; }
  </style>
</head>
<body>

<!-- TOPBAR -->
<div class="admin-topbar">
  <div class="admin-topbar-brand" style="display:flex;align-items:center;gap:10px;">
    <svg width="28" height="28" viewBox="0 0 680 680" xmlns="http://www.w3.org/2000/svg" style="flex-shrink:0">
      <path d="M 195,115 L 195,565 L 290,565 C 465,565 565,462 565,340 C 565,218 465,115 290,115 Z M 258,182 L 290,182 C 422,182 495,252 495,340 C 495,428 422,498 290,498 L 258,498 Z" fill="#C9922A"/>
      <g transform="translate(350,335) rotate(-30)">
        <path d="M -230,-18 L 0,-18 L 0,-65 Q 0,-73 8,-73 L 62,-73 Q 70,-73 70,-65 L 70,65 Q 70,73 62,73 L 8,73 Q 0,73 0,65 L 0,18 L -230,18 Q -238,18 -238,10 L -238,-10 Q -238,-18 -230,-18 Z" fill="#C9922A"/>
      </g>
    </svg>
    Dary BDS — Quản trị
  </div>
  <div class="admin-topbar-right">
    <a href="/" target="_blank" class="btn btn-outline btn-sm">Xem trang web</a>
    <a href="/admin/logout" class="btn btn-logout btn-sm">Đăng xuất</a>
  </div>
</div>

<div class="admin-wrap">

  <!-- THÔNG TIN LIÊN HỆ -->
  <div class="admin-section">
    <div class="admin-section-title">📞 Thông tin liên hệ</div>
    <div class="settings-card">
      <form method="POST" action="/admin/settings">
        <div class="field-row">
          <div class="field-group">
            <label>Số điện thoại</label>
            <input type="text" name="phone" value="<%= settings.phone || '' %>" placeholder="Ví dụ: 0901234567">
          </div>
          <div class="field-group">
            <label>Zalo (số điện thoại Zalo)</label>
            <input type="text" name="zalo" value="<%= settings.zalo || '' %>" placeholder="Ví dụ: 0901234567">
          </div>
        </div>
        <div class="field-group">
          <label>Facebook (link trang Facebook)</label>
          <input type="url" name="facebook" value="<%= settings.facebook || '' %>" placeholder="Ví dụ: https://facebook.com/trang-cua-ban">
        </div>
        <button type="submit" class="btn btn-primary">Lưu thông tin liên hệ</button>
      </form>
    </div>
  </div>

  <!-- THÊM SẢN PHẨM MỚI -->
  <div class="admin-section">
    <div class="admin-section-title">➕ Thêm sản phẩm mới</div>
    <div class="product-form-card">
      <form method="POST" action="/admin/products/create" enctype="multipart/form-data" id="createForm">
        <div class="field-row">
          <div class="field-group">
            <label>Tên sản phẩm *</label>
            <input type="text" name="name" placeholder="Ví dụ: Căn hộ 2PN view sông..." required>
          </div>
          <div class="field-group">
            <label>Loại</label>
            <select name="category">
              <option value="canho">Căn hộ</option>
              <option value="nhao">Nhà ở</option>
              <option value="dat">Đất</option>
            </select>
          </div>
        </div>
        <div class="field-row">
          <div class="field-group">
            <label>Giá bán</label>
            <input type="text" name="price" placeholder="Ví dụ: 2.5 tỷ">
          </div>
          <div class="field-group">
            <label>Vị trí</label>
            <input type="text" name="location" placeholder="Ví dụ: Quận 7, TP.HCM">
          </div>
        </div>
        <div class="field-group">
          <label>Thông tin liên hệ riêng (không bắt buộc)</label>
          <input type="text" name="contact" placeholder="Ví dụ: 0901234567">
        </div>

        <!-- VIDEO -->
        <div class="field-group">
          <label>Video (không bắt buộc)</label>
          <div class="upload-zone" id="createVideoZone">
            <input type="file" name="video" accept="video/mp4" id="createVideoInput" onchange="handleCreateVideo(this)">
            <div class="upload-zone-icon">🎬</div>
            <div class="upload-zone-text">Bấm để chọn video</div>
            <div class="upload-zone-sub">Định dạng MP4</div>
          </div>
          <div id="createVideoPreview"></div>
        </div>

        <!-- ẢNH SẢN PHẨM -->
        <div class="field-group">
          <label>Ảnh sản phẩm — bấm vào ảnh để chọn làm ảnh đại diện (viền vàng)</label>
          <div class="upload-zone" id="createImgZone">
            <input type="file" name="images" accept="image/png,image/jpeg,image/jpg" multiple id="createImgInput" onchange="handleCreateImages(this)">
            <div class="upload-zone-icon">🖼️</div>
            <div class="upload-zone-text">Bấm để chọn ảnh</div>
            <div class="upload-zone-sub">PNG, JPG — có thể chọn nhiều ảnh</div>
          </div>
          <div class="img-preview-grid" id="createImgPreview"></div>
          <input type="hidden" name="avatarIndex" id="createAvatarIndex" value="0">
        </div>

        <div class="field-group">
          <label>Mô tả chi tiết</label>
          <input type="hidden" name="description" id="createDescription">
          <div class="note-toolbar">
            <div class="note-toolbar-row">
              <span class="toolbar-label">Định dạng</span>
              <button type="button" class="toolbar-btn" onclick="createEditor.focus(); document.execCommand('bold')"><b>B</b></button>
              <button type="button" class="toolbar-btn" onclick="createEditor.focus(); document.execCommand('italic')"><i style="font-family:Georgia,serif;font-size:15px;font-weight:400;">I</i></button>
              <button type="button" class="toolbar-btn" onclick="createEditor.focus(); document.execCommand('underline')"><u>U</u></button>
              <div class="toolbar-sep"></div>
              <button type="button" class="toolbar-btn" onclick="createEditor.focus(); document.execCommand('justifyLeft')">
                <svg width="16" height="14" viewBox="0 0 16 14" fill="currentColor"><rect x="0" y="0" width="11.2" height="2.5" rx="1.2"/><rect x="0" y="5.5" width="16" height="2.5" rx="1.2"/><rect x="0" y="11" width="8" height="2.5" rx="1.2"/></svg>
              </button>
              <button type="button" class="toolbar-btn" onclick="createEditor.focus(); document.execCommand('justifyCenter')">
                <svg width="16" height="14" viewBox="0 0 16 14" fill="currentColor"><rect x="2.4" y="0" width="11.2" height="2.5" rx="1.2"/><rect x="0" y="5.5" width="16" height="2.5" rx="1.2"/><rect x="4" y="11" width="8" height="2.5" rx="1.2"/></svg>
              </button>
            </div>
            <div class="note-toolbar-row">
              <span class="toolbar-label">Cỡ chữ</span>
              <button type="button" class="toolbar-btn" onclick="setFontSizeCreate(14)">S</button>
              <button type="button" class="toolbar-btn" onclick="setFontSizeCreate(16)">M</button>
              <button type="button" class="toolbar-btn" onclick="setFontSizeCreate(20)">L</button>
              <button type="button" class="toolbar-btn" onclick="setFontSizeCreate(26)">XL</button>
            </div>
            <div class="note-toolbar-row">
              <label class="toolbar-btn toolbar-img-btn">
                🖼 Thêm ảnh
                <input type="file" accept="image/png,image/jpeg,image/jpg" style="display:none" onchange="uploadImageCreate(this)">
              </label>
            </div>
          </div>
          <div class="note-editor" id="createEditor" contenteditable="true" spellcheck="false"></div>
          <div id="createImgToolbar" class="img-toolbar" style="display:none;">
            <button class="img-toolbar-btn" onclick="deleteSelectedImgCreate()">🗑 Xóa</button>
          </div>
          <div id="createError" class="note-error" style="display:none;"></div>
        </div>
        <button type="button" class="btn btn-primary" onclick="submitCreate()">Thêm sản phẩm</button>
      </form>
    </div>
  </div>

  <!-- DANH SÁCH SẢN PHẨM -->
  <div class="admin-section">
    <div class="admin-section-title">📋 Danh sách sản phẩm (<%= products.length %>)</div>
    <% if (products.length === 0) { %>
      <div style="padding:40px;text-align:center;color:var(--text3);">Chưa có sản phẩm nào.</div>
    <% } else { %>
    <div class="admin-products-list">
      <% products.forEach(p => { %>
      <div class="admin-product-card">
        <% const adminAvatar = p.avatarUrl || (p.images && p.images.length > 0 ? (typeof p.images[0] === 'string' ? p.images[0] : p.images[0].url) : ''); %>
        <% if (adminAvatar) { %>
          <img class="admin-product-img" src="<%= adminAvatar %>" alt="<%= p.name %>">
        <% } else { %>
          <div class="admin-product-img-placeholder"><%= { canho: '🏢', nhao: '🏠', dat: '🌿' }[p.category] || '🏢' %></div>
        <% } %>
        <div class="admin-product-info">
          <div class="admin-product-name"><%= p.name %></div>
          <div class="admin-product-meta">
            <span class="admin-product-category"><%= { canho: 'Căn hộ', nhao: 'Nhà ở', dat: 'Đất' }[p.category] || p.category %></span>
            <% if (p.price) { %><span>💰 <%= p.price %></span><% } %>
            <% if (p.location) { %><span>📍 <%= p.location %></span><% } %>
          </div>
        </div>
        <div class="admin-product-actions">
          <button class="btn btn-outline btn-sm" onclick="openEditModal('<%= p._id %>')">✏️ Sửa</button>
          <form method="POST" action="/admin/products/<%= p._id %>/delete" style="display:inline" onsubmit="return confirm('Xóa sản phẩm này? Hành động không thể hoàn tác.')">
            <button type="submit" class="btn btn-danger btn-sm">🗑 Xóa</button>
          </form>
        </div>
      </div>
      <% }) %>
    </div>
    <% } %>
  </div>

</div>

<!-- MODAL SỬA SẢN PHẨM -->
<div class="modal-overlay" id="editModal">
  <div class="modal-box">
    <div class="modal-title">✏️ Sửa sản phẩm</div>
    <form method="POST" id="editForm" enctype="multipart/form-data">
      <div class="field-row">
        <div class="field-group">
          <label>Tên sản phẩm *</label>
          <input type="text" name="name" id="editName" required>
        </div>
        <div class="field-group">
          <label>Loại</label>
          <select name="category" id="editCategory">
            <option value="canho">Căn hộ</option>
            <option value="nhao">Nhà ở</option>
            <option value="dat">Đất</option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field-group">
          <label>Giá bán</label>
          <input type="text" name="price" id="editPrice">
        </div>
        <div class="field-group">
          <label>Vị trí</label>
          <input type="text" name="location" id="editLocation">
        </div>
      </div>
      <div class="field-group">
        <label>Thông tin liên hệ riêng</label>
        <input type="text" name="contact" id="editContact">
      </div>

      <!-- VIDEO HIỆN TẠI — hiện trước -->
      <div class="field-group" id="editVideoCurrentWrap">
        <label>Video hiện tại</label>
        <div id="editVideoCurrentInfo"></div>
        <input type="hidden" name="deleteVideo" id="editDeleteVideo" value="no">
      </div>

      <!-- THAY VIDEO MỚI -->
      <div class="field-group">
        <label>Thay video mới (không bắt buộc)</label>
        <div class="upload-zone">
          <input type="file" name="video" accept="video/mp4" id="editVideoNewInput" onchange="handleEditVideoNew(this)">
          <div class="upload-zone-icon">🎬</div>
          <div class="upload-zone-text">Bấm để chọn video mới</div>
          <div class="upload-zone-sub">Định dạng MP4</div>
        </div>
        <div id="editVideoNewPreview"></div>
      </div>

      <!-- ẢNH HIỆN TẠI -->
      <div class="field-group">
        <label>Ảnh hiện tại — bấm vào ảnh để chọn làm ảnh đại diện, bấm ✕ để xóa ảnh đó</label>
        <div class="img-preview-grid" id="editExistingImgGrid"></div>
        <input type="hidden" name="avatarUrl" id="editAvatarUrl" value="">
      </div>

      <!-- THÊM ẢNH MỚI -->
      <div class="field-group">
        <label>Thêm ảnh mới</label>
        <div class="upload-zone" id="editImgZone">
          <input type="file" name="images" accept="image/png,image/jpeg,image/jpg" multiple id="editImgNewInput" onchange="handleEditImagesNew(this)">
          <div class="upload-zone-icon">🖼️</div>
          <div class="upload-zone-text">Bấm để thêm ảnh mới</div>
          <div class="upload-zone-sub">PNG, JPG — có thể chọn nhiều ảnh</div>
        </div>
        <div class="img-preview-grid" id="editNewImgPreview"></div>
        <input type="hidden" name="avatarNewIndex" id="editAvatarNewIndex" value="">
      </div>

      <div class="field-group">
        <label>Mô tả chi tiết</label>
        <input type="hidden" name="description" id="editDescription">
        <div class="note-toolbar">
          <div class="note-toolbar-row">
            <span class="toolbar-label">Định dạng</span>
            <button type="button" class="toolbar-btn" onclick="editEditor.focus(); document.execCommand('bold')"><b>B</b></button>
            <button type="button" class="toolbar-btn" onclick="editEditor.focus(); document.execCommand('italic')"><i style="font-family:Georgia,serif;font-size:15px;font-weight:400;">I</i></button>
            <button type="button" class="toolbar-btn" onclick="editEditor.focus(); document.execCommand('underline')"><u>U</u></button>
            <div class="toolbar-sep"></div>
            <button type="button" class="toolbar-btn" onclick="editEditor.focus(); document.execCommand('justifyLeft')">
              <svg width="16" height="14" viewBox="0 0 16 14" fill="currentColor"><rect x="0" y="0" width="11.2" height="2.5" rx="1.2"/><rect x="0" y="5.5" width="16" height="2.5" rx="1.2"/><rect x="0" y="11" width="8" height="2.5" rx="1.2"/></svg>
            </button>
            <button type="button" class="toolbar-btn" onclick="editEditor.focus(); document.execCommand('justifyCenter')">
              <svg width="16" height="14" viewBox="0 0 16 14" fill="currentColor"><rect x="2.4" y="0" width="11.2" height="2.5" rx="1.2"/><rect x="0" y="5.5" width="16" height="2.5" rx="1.2"/><rect x="4" y="11" width="8" height="2.5" rx="1.2"/></svg>
            </button>
          </div>
          <div class="note-toolbar-row">
            <span class="toolbar-label">Cỡ chữ</span>
            <button type="button" class="toolbar-btn" onclick="setFontSizeEdit(14)">S</button>
            <button type="button" class="toolbar-btn" onclick="setFontSizeEdit(16)">M</button>
            <button type="button" class="toolbar-btn" onclick="setFontSizeEdit(20)">L</button>
            <button type="button" class="toolbar-btn" onclick="setFontSizeEdit(26)">XL</button>
          </div>
          <div class="note-toolbar-row">
            <label class="toolbar-btn toolbar-img-btn">
              🖼 Thêm ảnh
              <input type="file" accept="image/png,image/jpeg,image/jpg" style="display:none" onchange="uploadImageEdit(this)">
            </label>
          </div>
        </div>
        <div class="note-editor" id="editEditor" contenteditable="true" spellcheck="false"></div>
        <div id="editImgToolbar" class="img-toolbar" style="display:none;">
          <button class="img-toolbar-btn" onclick="deleteSelectedImgEdit()">🗑 Xóa</button>
        </div>
        <div id="editError" class="note-error" style="display:none;"></div>
      </div>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline" onclick="closeEditModal()">Hủy</button>
        <button type="button" class="btn btn-primary" onclick="submitEdit()">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>

<script>
// ── DỮ LIỆU SẢN PHẨM ──
const allProducts = <%- JSON.stringify(products) %>;

// ═══════════════════════════════════════════════════
// ── UPLOAD ẢNH/VIDEO FORM THÊM MỚI (CREATE) ──
// ═══════════════════════════════════════════════════
let createImageFiles = []; // mảng {file, objectUrl} theo thứ tự
let createAvatarIdx = 0;   // index trong createImageFiles được chọn làm avatar

function handleCreateImages(input) {
  const newFiles = Array.from(input.files);
  if (newFiles.length === 0) return;
  newFiles.forEach(file => {
    createImageFiles.push({ file, objectUrl: URL.createObjectURL(file) });
  });
  // Reset input để có thể chọn lại cùng file nếu cần
  input.value = '';
  renderCreateImgPreview();
}

function renderCreateImgPreview() {
  const grid = document.getElementById('createImgPreview');
  grid.innerHTML = '';
  createImageFiles.forEach((item, idx) => {
    const div = document.createElement('div');
    div.className = 'img-preview-item' + (idx === createAvatarIdx ? ' is-avatar' : '');
    div.title = 'Bấm để chọn làm ảnh đại diện';
    div.innerHTML =
      '<img src="' + item.objectUrl + '" alt="">' +
      '<div class="img-preview-badge">ĐẠI DIỆN</div>' +
      '<button type="button" class="img-preview-remove" title="Xóa ảnh này">✕</button>' +
      '<div class="img-preview-hint">Bấm để chọn làm đại diện</div>';
    // Chọn làm avatar khi bấm vào ảnh
    div.addEventListener('click', function(e) {
      if (e.target.classList.contains('img-preview-remove')) return;
      createAvatarIdx = idx;
      document.getElementById('createAvatarIndex').value = idx;
      renderCreateImgPreview();
    });
    // Xóa ảnh
    div.querySelector('.img-preview-remove').addEventListener('click', function(e) {
      e.stopPropagation();
      URL.revokeObjectURL(item.objectUrl);
      createImageFiles.splice(idx, 1);
      if (createAvatarIdx >= createImageFiles.length) createAvatarIdx = 0;
      if (createAvatarIdx > idx) createAvatarIdx--;
      document.getElementById('createAvatarIndex').value = createAvatarIdx;
      renderCreateImgPreview();
      rebuildCreateFileInput();
    });
    grid.appendChild(div);
  });
  document.getElementById('createAvatarIndex').value = createAvatarIdx;
}

function rebuildCreateFileInput() {
  // Tạo lại DataTransfer để gán file list mới cho input
  const dt = new DataTransfer();
  createImageFiles.forEach(item => dt.items.add(item.file));
  document.getElementById('createImgInput').files = dt.files;
}

// Video — CREATE
function handleCreateVideo(input) {
  const file = input.files[0];
  if (!file) return;
  const url = URL.createObjectURL(file);
  const wrap = document.getElementById('createVideoPreview');
  wrap.innerHTML =
    '<div class="video-preview-wrap">' +
      '<video src="' + url + '" controls></video>' +
      '<div class="video-preview-info">' +
        '<div class="video-preview-name">' + file.name + '</div>' +
