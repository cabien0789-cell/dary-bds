// Submit CREATE — dùng fetch+FormData để đảm bảo file thật sự được gửi lên server
async function submitCreate() {
  const btn = document.querySelector('#createForm .btn-primary');
  btn.disabled = true;
  btn.textContent = 'Đang lưu...';

  const form = document.getElementById('createForm');
  const fd = new FormData();

  fd.append('name', form.querySelector('[name="name"]').value);
  fd.append('category', form.querySelector('[name="category"]').value);
  fd.append('price', form.querySelector('[name="price"]').value || '');
  fd.append('location', form.querySelector('[name="location"]').value || '');
  fd.append('contact', form.querySelector('[name="contact"]').value || '');
  fd.append('description', createEditor.innerHTML);
  // Gửi avatarIndex đúng (index của ảnh được chọn làm đại diện trong thứ tự gốc)
  fd.append('avatarIndex', String(createAvatarIdx));

  // Gửi ảnh đúng thứ tự gốc, không sắp xếp lại
  createImageFiles.forEach(item => fd.append('images', item.file, item.file.name));

  // Video
  const videoInput = document.getElementById('createVideoInput');
  if (videoInput.files && videoInput.files[0]) {
    fd.append('video', videoInput.files[0], videoInput.files[0].name);
  }

  try {
    const res = await fetch('/admin/products/create', { method: 'POST', body: fd });
    // Server trả redirect (302) — fetch tự follow, kiểm tra URL cuối
    if (res.ok || res.redirected) {
      window.location.href = '/admin';
    } else {
      btn.disabled = false;
      btn.textContent = 'Thêm sản phẩm';
      alert('Có lỗi xảy ra, vui lòng thử lại.');
    }
  } catch(e) {
    btn.disabled = false;
    btn.textContent = 'Thêm sản phẩm';
    alert('Lỗi kết nối, vui lòng thử lại.');
  }
}

// ═══════════════════════════════════════════════════
// ── UPLOAD ẢNH/VIDEO FORM SỬA (EDIT) ──
// ═══════════════════════════════════════════════════
let editNewImageFiles = []; // ảnh mới thêm trong form sửa
let editAvatarSource = null; // 'existing' hoặc 'new'
let editAvatarExistingUrl = ''; // URL ảnh cũ được chọn làm avatar
let editAvatarNewIdx = -1;    // index trong editNewImageFiles được chọn làm avatar

function renderEditExistingImages(images, avatarUrl) {
  const grid = document.getElementById('editExistingImgGrid');
  grid.innerHTML = '';
  images.forEach((img, idx) => {
    const url = typeof img === 'string' ? img : img.url;
    const isAvatar = (url === avatarUrl);
    const div = document.createElement('div');
    div.className = 'img-preview-item' + (isAvatar ? ' is-avatar' : '');
    div.dataset.url = url;
    div.title = 'Bấm để chọn làm ảnh đại diện';
    div.innerHTML =
      '<img src="' + url + '" alt="">' +
      '<div class="img-preview-badge">ĐẠI DIỆN</div>' +
      '<button type="button" class="img-preview-remove" title="Xóa ảnh này">✕</button>' +
      '<div class="img-preview-hint">Bấm để chọn làm đại diện</div>' +
      '<input type="hidden" name="deleteImages" value="' + url + '" disabled>';
    // Chọn làm avatar
    div.addEventListener('click', function(e) {
      if (e.target.classList.contains('img-preview-remove')) return;
      if (div.classList.contains('marked-delete')) return;
      // Bỏ avatar khỏi tất cả ảnh cũ
      grid.querySelectorAll('.img-preview-item').forEach(el => el.classList.remove('is-avatar'));
      // Bỏ avatar khỏi ảnh mới
      document.getElementById('editNewImgPreview').querySelectorAll('.img-preview-item').forEach(el => el.classList.remove('is-avatar'));
      div.classList.add('is-avatar');
      editAvatarSource = 'existing';
      editAvatarExistingUrl = url;
      editAvatarNewIdx = -1;
      document.getElementById('editAvatarUrl').value = url;
      document.getElementById('editAvatarNewIndex').value = '';
    });
    // Đánh dấu xóa
    div.querySelector('.img-preview-remove').addEventListener('click', function(e) {
      e.stopPropagation();
      const isMarked = div.classList.contains('marked-delete');
      if (isMarked) {
        // Bỏ đánh dấu xóa
        div.classList.remove('marked-delete');
        div.querySelector('input[type="hidden"]').disabled = true;
        div.querySelector('.img-preview-remove').textContent = '✕';
      } else {
        // Đánh dấu xóa
        div.classList.add('marked-delete');
        div.classList.remove('is-avatar');
        div.querySelector('input[type="hidden"]').disabled = false;
        div.querySelector('.img-preview-remove').textContent = '↩';
        // Nếu ảnh này đang là avatar thì reset avatar
        if (editAvatarExistingUrl === url) {
          editAvatarExistingUrl = '';
          document.getElementById('editAvatarUrl').value = '';
        }
      }
    });
    grid.appendChild(div);
  });
}

function handleEditImagesNew(input) {
  const newFiles = Array.from(input.files);
  if (newFiles.length === 0) return;
  newFiles.forEach(file => {
    editNewImageFiles.push({ file, objectUrl: URL.createObjectURL(file) });
  });
  input.value = '';
  renderEditNewImgPreview();
}

function renderEditNewImgPreview() {
  const grid = document.getElementById('editNewImgPreview');
  grid.innerHTML = '';
  editNewImageFiles.forEach((item, idx) => {
    const isAvatar = (editAvatarSource === 'new' && idx === editAvatarNewIdx);
    const div = document.createElement('div');
    div.className = 'img-preview-item' + (isAvatar ? ' is-avatar' : '');
    div.title = 'Bấm để chọn làm ảnh đại diện';
    div.innerHTML =
      '<img src="' + item.objectUrl + '" alt="">' +
      '<div class="img-preview-badge">ĐẠI DIỆN</div>' +
      '<button type="button" class="img-preview-remove" title="Xóa">✕</button>' +
      '<div class="img-preview-hint">Bấm để chọn làm đại diện</div>';
    div.addEventListener('click', function(e) {
      if (e.target.classList.contains('img-preview-remove')) return;
      // Bỏ avatar khỏi ảnh cũ
      document.getElementById('editExistingImgGrid').querySelectorAll('.img-preview-item').forEach(el => el.classList.remove('is-avatar'));
      // Bỏ avatar khỏi ảnh mới
      grid.querySelectorAll('.img-preview-item').forEach(el => el.classList.remove('is-avatar'));
      div.classList.add('is-avatar');
      editAvatarSource = 'new';
      editAvatarNewIdx = idx;
      editAvatarExistingUrl = '';
      document.getElementById('editAvatarNewIndex').value = idx;
      document.getElementById('editAvatarUrl').value = '';
    });
    div.querySelector('.img-preview-remove').addEventListener('click', function(e) {
      e.stopPropagation();
      URL.revokeObjectURL(item.objectUrl);
      editNewImageFiles.splice(idx, 1);
      if (editAvatarSource === 'new') {
        if (editAvatarNewIdx === idx) { editAvatarNewIdx = -1; editAvatarSource = null; document.getElementById('editAvatarNewIndex').value = ''; }
        else if (editAvatarNewIdx > idx) { editAvatarNewIdx--; document.getElementById('editAvatarNewIndex').value = editAvatarNewIdx; }
      }
      renderEditNewImgPreview();
      rebuildEditFileInput();
    });
    grid.appendChild(div);
  });
}

function rebuildEditFileInput() {
  const dt = new DataTransfer();
  editNewImageFiles.forEach(item => dt.items.add(item.file));
  document.getElementById('editImgNewInput').files = dt.files;
}

