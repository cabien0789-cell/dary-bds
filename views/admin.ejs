// Upload ảnh vào mô tả — EDIT
async function uploadImageEdit(input) {
  const file = input.files[0];
  if (!file) return;
  if (!['image/png','image/jpeg','image/jpg'].includes(file.type)) {
    showErrorEdit('Chỉ chấp nhận file png hoặc jpg/jpeg.');
    input.value = ''; return;
  }
  const formData = new FormData();
  formData.append('image', file);
  const res = await fetch('/admin/products/' + currentEditId + '/upload-image', { method: 'POST', body: formData });
  const data = await res.json();
  if (data.error) { showErrorEdit(data.error); input.value = ''; return; }
  if (data.bytes) editImageBytesMap[data.url] = data.bytes;
  const img = document.createElement('img');
  img.src = data.url;
  img.style.maxWidth = '100%';
  img.style.borderRadius = '8px';
  img.style.margin = '8px 0';
  img.style.display = 'block';
  bindImageEventsEdit(img);
  const rangeInsideEditor = editSavedRange && editEditor.contains(editSavedRange.commonAncestorContainer);
  const lineBreak = document.createElement('br');
  if (rangeInsideEditor) {
    editEditor.focus();
    const sel = window.getSelection();
    sel.removeAllRanges(); sel.addRange(editSavedRange);
    editSavedRange.deleteContents();
    editSavedRange.insertNode(lineBreak);
    editSavedRange.insertNode(img);
    const newRange = document.createRange();
    newRange.setStartAfter(lineBreak); newRange.collapse(true);
    sel.removeAllRanges(); sel.addRange(newRange);
    editSavedRange = newRange.cloneRange();
  } else {
    editEditor.appendChild(img);
    editEditor.appendChild(lineBreak);
    editEditor.focus();
    const sel = window.getSelection();
    const newRange = document.createRange();
    newRange.setStartAfter(lineBreak); newRange.collapse(true);
    sel.removeAllRanges(); sel.addRange(newRange);
    editSavedRange = newRange.cloneRange();
  }
  input.value = '';
}

